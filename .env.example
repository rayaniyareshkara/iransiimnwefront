# Iransiim Store & Admin Environment Configuration

# Server Port (AI Studio mandates port 3000)
PORT=3000

# Public application base URL (used for payment callbacks)
PUBLIC_BASE_URL=

# Zibal Merchant Key (defaults to 'zibal' sandbox key if empty)
ZIBAL_MERCHANT=

# Zibal Gateway Base URL (defaults to https://gateway.zibal.ir)
ZIBAL_BASE_URL=https://gateway.zibal.ir

# Irancell / Iransiim Number Search API URL
NUMBER_SEARCH_URL=https://iransiim.ir/api/search
NUMBER_SEARCH_ORIGIN=https://iransiim.ir
NUMBER_SEARCH_HOST=iransiim.ir

# Product Images Proxy
PRODUCT_IMAGE_ORIGIN=https://shop.irancell.ir
PRODUCT_IMAGE_HOST=shop.irancell.ir

# Data Directory for Transactions Ledger
DATA_DIR=./server-data

# Timeout for upstream requests in ms
UPSTREAM_TIMEOUT_MS=15000
