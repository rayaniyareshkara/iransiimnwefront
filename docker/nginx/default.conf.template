server {
    listen       80;
    listen       [::]:80;
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    # The app is Persian/RTL and ships UTF-8 content.
    charset utf-8;

    # Behind ArvanCloud the client address arrives in a forwarded header;
    # without this every access log line shows the CDN edge instead.
    real_ip_header    X-Forwarded-For;
    real_ip_recursive on;
    set_real_ip_from  0.0.0.0/0;

    # ---- Compression --------------------------------------------------------
    gzip              on;
    gzip_vary         on;
    gzip_comp_level   6;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_types
        text/plain
        text/css
        text/xml
        application/javascript
        application/json
        application/xml
        application/xml+rss
        image/svg+xml
        font/woff
        font/woff2;

    # Uploads are not expected; keep the body small.
    client_max_body_size 1m;

    # ---- Health probe -------------------------------------------------------
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # ---- Payment API --------------------------------------------------------
    # Everything the payment server owns lives under /fapi/ — deliberately not
    # /api/, because the store backend already occupies that prefix on this
    # domain. One rule covers request, verify, result and the gateway callback.
    location /fapi/ {
        proxy_pass                 http://api:8787;
        proxy_http_version         1.1;
        proxy_set_header Host      $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout         60s;
        add_header Cache-Control   "no-store" always;
    }

    # ---- Number-search API proxy -------------------------------------------
    # The upstream service sends no CORS headers, so the browser calls
    # /api/... on this origin and nginx forwards it to the real backend.
    #
    # NUMBER_SEARCH_ORIGIN must NOT point back at the domain this server itself
    # answers on, or every /api/ request loops through the CDN into this same
    # location block forever. Point it at the actual API backend.
    location /api/ {
        # Loop guard. The header below is attached to everything this block
        # forwards, so seeing it on an *incoming* request means the upstream
        # routed straight back here. Fail immediately with a readable message
        # instead of burning every worker on an endless proxy chain.
        default_type text/plain;
        if ($http_x_iransiim_api_proxy) {
            return 508 "NUMBER_SEARCH_ORIGIN points back at this server - fix it in .env\n";
        }

        proxy_pass                 ${NUMBER_SEARCH_ORIGIN}/api/;
        proxy_http_version         1.1;
        proxy_set_header Host      ${NUMBER_SEARCH_HOST};
        proxy_set_header Connection "";
        proxy_set_header X-Iransiim-Api-Proxy 1;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SNI is required or the TLS handshake with the upstream fails.
        proxy_ssl_server_name      on;
        proxy_ssl_name             ${NUMBER_SEARCH_HOST};

        proxy_connect_timeout      10s;
        proxy_send_timeout         30s;
        proxy_read_timeout         30s;

        # Search results are per-request; never cache them.
        proxy_buffering            off;
        add_header Cache-Control   "no-store" always;
    }

    # ---- Product image proxy ------------------------------------------------
    # Thumbnails referenced by the search API live on shop.irancell.ir, which
    # refuses direct browser image requests, so they are served through here.
    location /product-image/ {
        proxy_pass                 ${PRODUCT_IMAGE_ORIGIN}/;
        proxy_http_version         1.1;
        proxy_set_header Host      ${PRODUCT_IMAGE_HOST};
        proxy_set_header Connection "";

        proxy_ssl_server_name      on;
        proxy_ssl_name             ${PRODUCT_IMAGE_HOST};

        proxy_connect_timeout      10s;
        proxy_read_timeout         30s;

        # Filenames carry a date stamp, so the bytes behind a URL do not change.
        proxy_cache_valid          200 7d;
        add_header Cache-Control   "public, max-age=604800" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # ---- Hashed build assets: safe to cache forever -------------------------
    # Vite emits content-hashed filenames into /assets, so a change always
    # produces a new URL.
    location /assets/ {
        access_log off;
        add_header Cache-Control          "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff"                    always;
        add_header X-Frame-Options        "SAMEORIGIN"                 always;
        add_header Referrer-Policy        "strict-origin-when-cross-origin" always;
        try_files $uri =404;
    }

    # ---- App shell: must never be cached ------------------------------------
    # Otherwise clients keep loading a stale index.html that points at
    # build assets which no longer exist.
    location = /index.html {
        add_header Cache-Control          "no-cache, no-store, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff"                    always;
        add_header X-Frame-Options        "SAMEORIGIN"                 always;
        add_header Referrer-Policy        "strict-origin-when-cross-origin" always;
    }

    # ---- SPA fallback -------------------------------------------------------
    # RouterContext uses the History API (/admin/..., /checkout, ...), so any
    # unknown path must return index.html and let the client router resolve it.
    location / {
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff"                    always;
        add_header X-Frame-Options        "SAMEORIGIN"                 always;
        add_header Referrer-Policy        "strict-origin-when-cross-origin" always;
        try_files $uri $uri/ /index.html;
    }

    # Do not leak the nginx version on error pages.
    server_tokens off;
}
